{ "compilerOptions": { "target": "es2017", "lib": ["dom", "esnext"], "jsx": "preserve", "module": "esnext",
  "moduleResolution": "bundler", "strict": true, "noEmit": true, "esModuleInterop": true, "skipLibCheck": true,
  "incremental": true, "allowJs": true, "isolatedModules": true, "resolveJsonModule": true,
  "plugins": [{ "name": "next" }] },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx"], "exclude": ["node_modules"] }
